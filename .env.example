# Copy this file to ".env" and edit. ".env" is git-ignored and must never be committed.

# --- MySQL / MariaDB ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kids_world

# --- Web server ---
PORT=3000
# 127.0.0.1 = only this computer. Use 0.0.0.0 so a tablet/phone on your Wi-Fi can connect.
HOST=127.0.0.1
# Address people use to open the site (used in password-reset links)
APP_URL=http://localhost:3000
# Set to true when the site is served over HTTPS (cookies get the Secure flag)
COOKIE_SECURE=false
SESSION_DAYS=14
# Allow new accounts to be created from the login page (the admin can also switch this in the dashboard)
ALLOW_REGISTRATION=true
MAX_CHILDREN=8

# --- First admin (optional; or run: npm run admin:create -- you@example.com "Your Name") ---
# Used only when no admin exists yet. Remove ADMIN_PASSWORD from this file after the first start.
# ADMIN_EMAIL=you@example.com
# ADMIN_NAME=Your Name
# ADMIN_PASSWORD=

# --- E-mail for password reset (optional) ---
# Without SMTP the reset link is printed in the server console and the admin can generate links from the dashboard.
# To send real e-mails also run: npm install nodemailer
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Kids World <no-reply@example.com>
