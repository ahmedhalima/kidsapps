{
  "name": "kids-world",
  "version": "2.0.0",
  "description": "Arabic learning games site for kids with accounts, multiple children, MySQL storage and an admin dashboard",
  "private": true,
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node server/index.js",
    "db:setup": "node server/scripts/db-setup.js",
    "admin:create": "node server/scripts/create-admin.js",
    "test": "node tests/smoke.js && node --test tests/server.test.js tests/integration.test.js",
    "build": "node scripts/build-single.js"
  },
  "dependencies": {
    "mysql2": "^3.11.0"
  },
  "optionalDependencies": {
    "nodemailer": "^6.9.14"
  },
